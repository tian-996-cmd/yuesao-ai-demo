{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:api": "tsx watch backend/src/server.ts",
    "build": "vinext build",
    "build:api": "tsc -p backend/tsconfig.json",
    "build:production": "vite build --config vite.production.config.ts",
    "build:vercel": "vite build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "db:seed": "tsx backend/src/db/seed.ts",
    "test:api": "npm run build:api && node --test backend/test/*.test.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "fastify": "^5.12.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "nitro": "^3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
